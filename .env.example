MAKOTO_MODE=sender
MAKOTO_TIMEZONE=Asia/Jakarta
MAKOTO_RATE_LIMIT_PER_MINUTE=100

# Link tracking. Every kyou.id href leaving Makoto gets UTM params appended, so a
# click can be attributed to the email that produced it (mail clients strip the
# Referer header, so the attribution has to live in the URL). utm_campaign is the
# feature name (birthday, po_ready, ...) and utm_content is the template variant
# (po_ready2), both filled automatically. Non-kyou.id links are left alone.
MAKOTO_LINK_TRACKING_ENABLED=true
MAKOTO_UTM_SOURCE=kyou-email
MAKOTO_UTM_MEDIUM=email

OLD_DATABASE_HOST=
OLD_DATABASE_PORT=3306
OLD_DATABASE_NAME=
OLD_DATABASE_USERNAME=
OLD_DATABASE_PASSWORD=

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
MAKOTO_QUEUE_NAME=birthday_email_jobs
MAKOTO_DEAD_LETTER_QUEUE=birthday_email_jobs_dead
MAKOTO_MAX_ATTEMPTS=3

KIRIM_EMAIL_USERNAME=
KIRIM_EMAIL_API_TOKEN=
KIRIM_EMAIL_BASE_URL=https://smtp-app.kirim.email
KIRIM_EMAIL_DOMAIN=kyou.id
KIRIM_EMAIL_VALIDATE=false
KIRIM_EMAIL_VALIDATION_USERNAME=
KIRIM_EMAIL_VALIDATION_API_TOKEN=
KIRIM_EMAIL_VALIDATION_FAIL_OPEN=false
KIRIM_EMAIL_FROM_EMAIL=nandayo@kyou.id
KIRIM_EMAIL_FROM_NAME=Kyou.id

# Birthday. Subject TIDAK diatur lewat env — lihat internal/config/config.go.
MAKOTO_TEMPLATE_IDS=birthday1.html,birthday2.html,birthday3.html
MAKOTO_EMAIL_TEMPLATE_DIR=templates/birthday
MAKOTO_ACTION_URL=https://kyou.id/user/my-voucher

MAKOTO_ANNIVERSARY_QUEUE_NAME=anniversary_email_jobs
MAKOTO_ANNIVERSARY_DEAD_LETTER_QUEUE=anniversary_email_jobs_dead
MAKOTO_ANNIVERSARY_TEMPLATE_IDS=anniversary1.html,anniversary2.html,anniversary3.html
MAKOTO_ANNIVERSARY_EMAIL_TEMPLATE_DIR=templates/anniversary

MAKOTO_LEFTOVER_CART_QUEUE_NAME=leftover_cart_email_jobs
MAKOTO_LEFTOVER_CART_DEAD_LETTER_QUEUE=leftover_cart_email_jobs_dead
MAKOTO_LEFTOVER_CART_TEMPLATE_IDS=leftover_cart1.html,leftover_cart2.html,leftover_cart3.html,leftover_cart4.html,leftover_cart5.html
MAKOTO_LEFTOVER_CART_EMAIL_TEMPLATE_DIR=templates/leftover_cart

MAKOTO_DISCOUNTED_WISHLIST_ENABLED=false
MAKOTO_DISCOUNTED_WISHLIST_QUEUE_NAME=discounted_wishlist_email_jobs
MAKOTO_DISCOUNTED_WISHLIST_DEAD_LETTER_QUEUE=discounted_wishlist_email_jobs_dead
MAKOTO_DISCOUNTED_WISHLIST_TEMPLATE_IDS=discounted_wishlist1.html,discounted_wishlist2.html,discounted_wishlist3.html
MAKOTO_DISCOUNTED_WISHLIST_EMAIL_TEMPLATE_DIR=templates/discounted_wishlist
# Wishlist user, difilter ke item yang promonya lagi aktif (hanamaru: ?status=promotion).
MAKOTO_DISCOUNTED_WISHLIST_URL=https://kyou.id/user/wishlist?status=promotion
# Unsubscribe/preference-center di-handle oleh Kirim.email (List-Unsubscribe / footer provider),
# jadi Makoto tidak perlu env unsubscribe khusus untuk discounted wishlist.

# Winback (default OFF — set true untuk mengaktifkan sender winback).
# Queue name HARUS sama dgn YUKARI_WINBACK_QUEUE_NAME. GREETINGS dipisah pipe "|"
# (dipilih deterministik dari date+job ID). Subject tidak diatur lewat env.
MAKOTO_WINBACK_ENABLED=false
MAKOTO_WINBACK_QUEUE_NAME=winback_email_jobs
MAKOTO_WINBACK_DEAD_LETTER_QUEUE=winback_email_jobs_dead
MAKOTO_WINBACK_TEMPLATE_IDS=winback1.html,winback2.html,winback3.html
MAKOTO_WINBACK_EMAIL_TEMPLATE_DIR=templates/winback
MAKOTO_WINBACK_GREETINGS='Hei {{ .FirstName }}, udah lama banget nih nggak ketemu!|{{ .FirstName }}, kita kangen sama kamu!|Lama nggak belanja di Kyou, {{ .FirstName }}?|{{ .FirstName }}, ada yang nungguin kamu balik nih!|Psst {{ .FirstName }}, ada voucher spesial buat kamu!'
MAKOTO_WINBACK_ACTION_URL=https://kyou.id/user/my-voucher

# Wishlist back-in (default OFF — set true untuk mengaktifkan sender).
# Queue name HARUS sama dgn YUKARI_WISHLIST_BACK_IN_QUEUE_NAME.
MAKOTO_WISHLIST_BACK_IN_ENABLED=false
MAKOTO_WISHLIST_BACK_IN_QUEUE_NAME=wishlist_back_in_email_jobs
MAKOTO_WISHLIST_BACK_IN_DEAD_LETTER_QUEUE=wishlist_back_in_email_jobs_dead
MAKOTO_WISHLIST_BACK_IN_TEMPLATE_IDS=wishlist_back_in1.html,wishlist_back_in2.html,wishlist_back_in3.html
MAKOTO_WISHLIST_BACK_IN_EMAIL_TEMPLATE_DIR=templates/wishlist_back_in
MAKOTO_WISHLIST_BACK_IN_GREETINGS='Omatase, {{ .FirstName }}! Yang kamu tunggu akhirnya balik.|{{ .FirstName }}, penantiannya selesai. Wishlist kamu ready lagi!|Kabar baik, {{ .FirstName }}. Item incaranmu sudah kembali!'
MAKOTO_WISHLIST_BACK_IN_ACTION_URL=https://kyou.id/user/my-voucher

# PO Ready — a PO item on the user's wishlist was converted to ready stock.
# No voucher; MAKOTO_PO_READY_URL is the single CTA target.
# Queue name must match Yukari's YUKARI_PO_READY_QUEUE_NAME exactly.
MAKOTO_PO_READY_ENABLED=false
MAKOTO_PO_READY_QUEUE_NAME=po_ready_email_jobs
MAKOTO_PO_READY_DEAD_LETTER_QUEUE=po_ready_email_jobs_dead
MAKOTO_PO_READY_TEMPLATE_IDS=po_ready1.html,po_ready2.html,po_ready3.html
MAKOTO_PO_READY_EMAIL_TEMPLATE_DIR=templates/po_ready
MAKOTO_PO_READY_GREETINGS='Omatase, {{ .FirstName }}! Wishlist kamu akhirnya jadi ready.|Kabar baik, {{ .FirstName }}! PO yang kamu tunggu udah ready.|{{ .FirstName }}, penantianmu selesai — wishlist kamu udah ready!|Hei {{ .FirstName }}, wishlist kamu udah ready nih di Kyou!'
MAKOTO_PO_READY_URL=https://kyou.id/user/wishlist

DISCORD_WEBHOOK_ENABLED=true
DISCORD_WEBHOOK_URL=

# --- Webhook Kirim.email (laporan delivered/bounced/opened/clicked) ---
# Makoto membuka satu endpoint HTTP untuk menerima laporan pengiriman dari
# Kirim.email. Kosongkan MAKOTO_WEBHOOK_ADDR -> tidak ada listener sama sekali
# (perilaku Makoto sebelum fitur ini ada); para worker tidak bergantung padanya.
#
# Cara kerjanya: Kirim.email TIDAK mengembalikan message id waktu email dikirim
# (respons-nya cuma {"success":true,"message":"..."}), jadi Makoto menstempel tiap
# email dengan field `tags` berisi <job_id>, dan Kirim.email mengembalikannya di
# field `tags` tiap webhook. Itulah kunci pencocokan ke email_delivery_logs.
# (Field `headers`/X-Tags yang didokumentasikan Kirim.email TIDAK BISA dipakai:
# validatornya menolak string karena "harus array" dan array karena "harus string".)
#
# TIDAK ADA MIGRASI. Laporannya dilipat ke baris yang sudah ada di
# email_delivery_logs: cap waktu masuk ke kolom `metadata` (JSON) di bawah kunci
# "delivery", dan message_guid mengisi `provider_message_id` yang selama ini NULL.
# Kolom `status` tidak disentuh — itu tulang punggung anti-dobel milik Yukari.
#
# Yang perlu dilakukan sekali: daftarkan URL-nya di dashboard Kirim.email ->
# Webhooks, satu baris per event type (delivered, bounced, permanent_fail,
# opened, clicked, ...), semuanya menunjuk ke URL yang sama.
MAKOTO_WEBHOOK_ADDR=
MAKOTO_WEBHOOK_PATH=/webhooks/kirim
# BIARKAN KOSONG. Kirim.email menandatangani tiap payload dengan
#   hash('sha256', $apiSecret . $messageGuid)
# dan $apiSecret itu KIRIM_EMAIL_API_TOKEN di atas — token yang sama yang dipakai
# mengirim email (sudah dibuktikan dengan payload uji dari dashboard). Jadi kalau
# dibiarkan kosong, Makoto otomatis memakai KIRIM_EMAIL_API_TOKEN. Isi ini hanya
# kalau suatu hari Kirim.email memisahkan kunci webhook dari kunci API.
KIRIM_WEBHOOK_SECRET=
# Event yang dilaporkan ke Discord SATU PER SATU. Default kosong: semua event
# dihitung ke dalam ringkasan per campaign (lihat di bawah), bukan diumumkan
# satu-satu. Isi "bounced,permanent_fail" kalau kamu mau kartu langsung tiap ada
# bounce, di luar ringkasan.
MAKOTO_WEBHOOK_NOTIFY_EVENTS=

# --- Ringkasan per campaign ---
# Satu embed per campaign, dikirim setelah antreannya sepi: berapa diproses,
# berapa terkirim, berapa sampai, berapa bounce/gagal/dilewati.
MAKOTO_SUMMARY_ENABLED=true
# Berapa menit antrean harus sepi sebelum ringkasannya dikirim. INI BUKAN basa-basi:
# laporan delivered/bounced dari Kirim.email baru datang beberapa detik sampai
# beberapa menit SETELAH email dikirim. Kalau ringkasan dikirim persis saat antrean
# habis, angka "sampai" dan "bounce" akan NOL terus — dan bounce jadi tak terlihat
# di mana pun.
MAKOTO_SUMMARY_SETTLE_MINUTES=10
# Notifikasi per email terkirim/gagal ([Birthday Email Sent] dst). Default mati:
# Discord membuang kiriman webhook di atas ~30/menit, dan satu run winback (ribuan
# email) akan mengubur ringkasan beserta bounce yang justru penting.
# Alarm sistem (ack gagal, failure handling gagal) TETAP dikirim — itu tanda
# pipanya rusak, dan tidak boleh dibungkam oleh preferensi pelaporan.
MAKOTO_DISCORD_PER_EMAIL=false
