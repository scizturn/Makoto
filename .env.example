KIRIM_EMAIL_FROM_EMAIL=nandayo@kyou.id
KIRIM_EMAIL_FROM_NAME=Kyou.id

MAKOTO_TEMPLATE_IDS=birthday1.html,birthday2.html,birthday3.html
